# Copy to .env and fill in ANTHROPIC_API_KEY. Everything else has a working default.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAIN=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
LLM_MODE=live            # live | mock  (live without a key automatically falls back to mock)
DATABASE_URL=postgresql+psycopg://snapfix:snapfix@db:5432/snapfix
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
STT_FALLBACK=faster-whisper   # faster-whisper | none
NOTIFIER=console              # console | slack | twilio
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_TO=
ADMIN_TOKEN=change-me
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BLUR_FACES=false
EMERGENCY_TEXT="If you smell gas or see fire/smoke, leave the area and call 911."
